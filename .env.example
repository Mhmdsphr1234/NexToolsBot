# توکن ربات که از BotFather گرفتید
BOT_TOKEN=your_telegram_bot_token_here

# مسیر کامل فایل اجرایی Tesseract روی ویندوز
# اگر Tesseract را با تنظیمات پیش‌فرض نصب کرده باشید، معمولاً همین مسیر درست است
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# سطح جزئیات لاگ‌ها: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# پوشه‌ای که فایل‌های دانلودی/موقت داخلش ذخیره می‌شوند
DOWNLOAD_DIR=downloads

# حداکثر حجم مجاز فایل (مگابایت) برای ارسال/دریافت در تلگرام
MAX_FILE_SIZE_MB=45
